{
  "version": 3,
  "configurePresets": [
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "clangd",
      "displayName": "Clangd (compile_commands.json for IDE tooling, Windows/MSVC)",
      "description": "Ninja+MSVC build used only to generate compile_commands.json for clangd. Not for building. Run from a VS 2022 x64 developer prompt.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_clangd",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo",
      "configurePreset": "vs2022",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "configurePreset": "vs2022",
      "configuration": "Debug"
    }
  ]
}
